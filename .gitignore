# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Engagement output (never commit scan data / client artifacts)
engagement/
demo_engagement/
demo_out/
test_engagement/

# Test environment (docker compose). The compose file + supporting
# Dockerfiles + sample importer files are TRACKED so anyone cloning the repo
# has a working lab out of the box. Runtime artifacts (volumes, .env, per-
# operator overrides, transient logs) stay ignored.
test_env/.env
test_env/.env.local
test_env/*.log
test_env/data/
test_env/volumes/
*.sqlite
*.xlsx
raw/

# Build artifacts
build/
dist/
releases/
dump.rdb
*.rdb

# web frontend dev artifacts
recce/webui/frontend/node_modules/

# Claude Code — .claude/settings.json is the shared allowlist (tracked
# separately). Local overrides and any temp files it writes should not
# travel with the repo.
.claude/settings.local.json
.claude/settings.local.json.tmp.*
.claude/history.jsonl
