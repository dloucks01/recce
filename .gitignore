# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Engagement output (never commit scan data / client artifacts)
engagement/
demo_engagement/
demo_out/
test_engagement/

# Test environment (docker compose). The compose file + supporting
# Dockerfiles + sample importer files are TRACKED so anyone cloning the repo
# has a working lab out of the box. Runtime artifacts (volumes, .env, per-
# operator overrides, transient logs) stay ignored.
test_env/.env
test_env/.env.local
test_env/*.log
test_env/data/
test_env/volumes/
*.sqlite
*.xlsx
raw/

# Build artifacts
build/
dist/
releases/
dump.rdb
*.rdb

# web frontend dev artifacts
recce/webui/frontend/node_modules/

# IDE / editor config
.vscode/
.idea/
*.swp

# Test cache
.pytest_cache/

# Session-internal artifacts under .recce-plan/ that are not durable
# reference material:
#   * hooks/         — extracted integration-hook payloads from workflow
#                      agents; consumed once during wire-up, not needed
#                      after commit lands.
#   * */plan_raw.jsonl — raw workflow agent transcripts; the readable
#                      summaries live in the sibling *.md / *.json files.
.recce-plan/hooks/
.recce-plan/*/plan_raw.jsonl
